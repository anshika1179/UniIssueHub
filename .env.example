# ============================================
# UniIssueHub — Environment Variables Template
# ============================================
# Copy this file to .env and fill in your values.
# DO NOT commit .env to version control.
# ============================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/uniissuehub

# JWT (Phase 2)
JWT_SECRET=your_strong_jwt_secret_here_min_32_chars
JWT_EXPIRE=1d

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Email (Phase 6 — not yet implemented)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_password_here
EMAIL_FROM=noreply@uniissuehub.com

# File Uploads (Phase 3)
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
