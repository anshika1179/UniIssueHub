# ============================================
# UniIssueHub — Environment Variables Template
# ============================================
# Copy this file to server/.env and fill in your values.
# DO NOT commit .env to version control.
# ============================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/uniissuehub

# JWT (Phase 2)
JWT_SECRET=your_strong_jwt_secret_here_min_32_chars
JWT_EXPIRE=1d

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Email / SMTP (Phase 6)
# These variable names must match exactly — the email service reads SMTP_HOST, SMTP_PORT, etc.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_email_password_here
SMTP_FROM=noreply@uniissuehub.com

# AI Provider (Phase 5 — defaults to local, no key required)
AI_PROVIDER=local
