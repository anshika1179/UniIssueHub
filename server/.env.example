# ============================================
# UniIssueHub - server environment template
# ============================================
# Copy this file to server/.env and fill in your values:
#   cd server && cp .env.example .env
# DO NOT commit server/.env to version control.

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/uniissuehub

# JWT (use any random string, 32+ characters)
JWT_SECRET=replace_with_a_random_string_of_32_or_more_characters
JWT_EXPIRE=1d

# Google sign-in: use the same OAuth web client ID as client/.env
GOOGLE_CLIENT_ID=

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Email / SMTP (Gmail sender)
# The email service reads exactly these names (server/services/notification/emailService.js).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=uniissuehub@gmail.com
SMTP_FROM=uniissuehub@gmail.com
# TODO: add the Google app password for uniissuehub@gmail.com here (16 characters, needs 2-Step Verification).
# Not your normal Gmail password. Until this is set, emails are skipped.
SMTP_PASSWORD=

# AI Provider (defaults to local, no key required)
AI_PROVIDER=local
